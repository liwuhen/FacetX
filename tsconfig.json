// Check top-level tooling here. Package projects extend @lichtblick/tsconfig/base
// and own the files they include.
{
  "extends": "@lichtblick/tsconfig/base",
  "include": [
    "./*.ts",
    "./*.js",
    "./**/jest.config.ts",
    "./ci/**/*.ts",
    "./e2e/ci-helpers/**/*.ts",
    "./benchmark/e2e/ci-helpers/**/*.ts",
    "./package.json"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "commonjs",
    "types": ["node"],
    "noEmit": true
  }
}
